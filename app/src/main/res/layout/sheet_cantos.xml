<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="@dimen/gap_grande"
    android:paddingEnd="@dimen/gap_grande"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            style="@style/Texto.Titulo.Sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cantos" />

        <TextView
            style="@style/Texto.Cuerpo.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/negro_22"
            android:text="@string/hint_cantos" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/cerrar"
        style="@style/Boton.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_fila_blanca"
        android:textColor="@color/madera_oscura"
        android:text="@string/cerrar" />
</LinearLayout>

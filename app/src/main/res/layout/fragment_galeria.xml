<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/madera_oscura"
    android:fitsSystemWindows="true">

    <!-- El padding horizontal va en cada hijo, no en la raíz: fitsSystemWindows pisa el
         padding del root con los insets del sistema y lo deja en 0 a los costados. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_pantalla"
        android:paddingEnd="@dimen/padding_pantalla"
        android:paddingTop="6dp">

        <include
            android:id="@+id/volver"
            layout="@layout/fila_volver" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="@dimen/padding_pantalla"
        android:paddingEnd="@dimen/padding_pantalla"
        android:paddingTop="8dp">

        <TextView
            style="@style/Texto.Titulo.Seccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/el_museo" />

        <TextView
            android:id="@+id/contador"
            style="@style/Texto.Cuerpo.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            tools:text="6 derrotas documentadas" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="@dimen/padding_pantalla"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/vacio"
        style="@style/Texto.Cuerpo.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="@dimen/padding_pantalla"
        android:paddingEnd="@dimen/padding_pantalla"
        android:visibility="gone"
        android:text="@string/museo_vacio" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fotos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:paddingStart="@dimen/padding_pantalla"
        android:paddingEnd="@dimen/padding_pantalla"
        android:clipToPadding="false"
        tools:listitem="@layout/celda_museo" />

    <TextView
        style="@style/Texto.Cuerpo.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_pantalla"
        android:paddingEnd="@dimen/padding_pantalla"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:text="@string/pie_museo" />
</LinearLayout>

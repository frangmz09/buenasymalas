<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingStart="@dimen/gap_grande"
    android:paddingEnd="@dimen/gap_grande"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_handle" />

    <TextView
        style="@style/Texto.Titulo.Sheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/titulo_sumar_jugador" />

    <EditText
        android:id="@+id/buscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/archivo"
        android:textSize="16sp"
        android:textColor="@color/madera_oscura"
        android:textColorHint="@color/negro_22"
        android:backgroundTint="@color/cobre"
        android:hint="@string/hint_buscar_jugador"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="16"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/vacio"
        style="@style/Texto.Cuerpo.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/negro_22"
        android:visibility="gone"
        android:text="@string/mesa_vacia_para_buscar" />

    <LinearLayout
        android:id="@+id/resultados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp" />
</LinearLayout>
